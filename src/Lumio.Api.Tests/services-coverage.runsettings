<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverage scope: Validators layer (SP-3: T-008).
  Excludes Controllers, Middleware, Migrations, Data scaffolding, Program.cs.
  Pass via: dotnet test with the settings flag pointing to this file.
  SP-3-T008: Scoped gate for validators — threshold 90%.
  Roadmap: expand scope to Services in SP-6 once service tests added.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Include only validator classes — SP-3 specifically adds validator tests.
               Scoping to Validators gives an honest, enforced high-coverage gate.
               Services scope will be added in SP-6 (roadmap). -->
          <Include>[Lumio.Api]Lumio.Api.Validators.*</Include>
          <!-- Exclude generated code, EF migrations, and Data-context scaffolding -->
          <ExcludeByFile>
            **/Migrations/**/*.cs
            **/obj/**/*.cs
          </ExcludeByFile>
          <!-- Exclude Controllers, Middleware, Program, Extensions, Dtos (untested) -->
          <Exclude>
            [Lumio.Api]Lumio.Api.Controllers.*
            [Lumio.Api]Lumio.Api.Middleware.*
            [Lumio.Api]Lumio.Api.Data.*
            [Lumio.Api]Lumio.Api.Extensions.*
            [Lumio.Api]Lumio.Api.Dtos.*
            [Lumio.Api]Lumio.Api.Domain.*
            [Lumio.Api]Lumio.Api.Resources.*
          </Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <Format>cobertura</Format>
          <UseSourceLink>true</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
