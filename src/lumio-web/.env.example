# Lumio Web — Environment Variables
# Copy this file to .env.local and fill in your values.
# All NEXT_PUBLIC_ variables are exposed to the browser bundle.

# ── Analytics (SP-6-006 / COMPLIANCE_RISK-GROWTH-001) ─────────────────────────
# PostHog project API key (leave empty to disable analytics entirely)
# DPO approval required before enabling — see devdocs/dpia-bijzondere-categorieen.md
# GUARD-006: auto-capture is disabled; never log legacy/health data in events.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog API host (default: https://app.posthog.com)
# Override for EU region: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
