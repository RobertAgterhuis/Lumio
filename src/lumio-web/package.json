{
  "name": "lumio-web",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "author": {
    "name": "Robert Agterhuis",
    "email": "ragterhuis@agterhuis.net",
    "url": "https://blog.agterhuis.net"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/generate-help-content.js",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "generate-api": "openapi-ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "validate-tokens": "npx tsx scripts/validate-tokens.ts",
    "detect-breaking-changes": "npx tsx scripts/detect-breaking-changes.ts"
  },
  "size-limit": [
    {
      "name": "Initial JS (framework)",
      "path": "out/_next/static/chunks/turbopack-*.js",
      "limit": "200 KB",
      "gzip": true
    },
    {
      "name": "All JS chunks",
      "path": "out/_next/static/chunks/*.js",
      "limit": "600 KB",
      "gzip": true
    },
    {
      "name": "CSS output",
      "path": "out/_next/static/chunks/*.css",
      "limit": "30 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.575.0",
    "marked": "^17.0.3",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.1",
    "@chromatic-com/storybook": "^5.0.1",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.92.4",
    "@next/bundle-analyzer": "^16.1.6",
    "@size-limit/file": "^12.0.0",
    "@size-limit/preset-app": "^12.0.0",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@storybook/nextjs-vite": "^10.2.10",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "axe-core": "^4.11.1",
    "axe-playwright": "^2.2.2",
    "chromatic": "^15.2.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-storybook": "^10.2.10",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "size-limit": "^12.0.0",
    "storybook": "^10.2.10",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
